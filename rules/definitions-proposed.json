{
  "Email": {
    "region": null,
    "rules": [
      [{ "regex": "[A-Za-z0-9._+\\-\\']+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}" }]
    ]
  },
  "Phone Number": {
    "region": null,
    "rules": [
      [{ "regex": "(?:\\+[9٩۹][6٦۶][2٢۲]|\\b[0٠۰]{2}[9٩۹][6٦۶][2٢۲]|\\b[0٠۰])[ -]?[7٧۷][789٧٨٩۷۸۹][ -]?\\d{3}[ -]?\\d{4}\\b" }],
      [{ "regex": "(?:\\+[9٩۹][6٦۶][2٢۲]|\\b[0٠۰]{2}[9٩۹][6٦۶][2٢۲]|\\b[0٠۰])[ -]?[6٦۶][ -]?\\d{3}[ -]?\\d{4}\\b" }],
      [{ "regex": "(?:\\+[9٩۹][6٦۶][3٣۳]|\\b[0٠۰]{2}[9٩۹][6٦۶][3٣۳]|\\b[0٠۰])[ -]?[9٩۹]\\d{2}[ -]?\\d{3}[ -]?\\d{3}\\b" }]
    ]
  },
  "Jordanian National ID": {
    "region": "Jordan",
    "rules": [
      [{ "regex": "(?:IDJOR)(?:[A-Z0-9<].+)" }],
      [
        { "keywords": ["Jordan"] },
        { "keywords": ["Ministry of Interior", "Civil Status"] }
      ],
      [
        { "keywords": ["ID"] },
        { "keywords": ["<<"] }
      ]
    ]
  },
  "Jordanian Passport": {
    "region": "Jordan",
    "rules": [
      [{ "regex": "P<JOR[A-Z<]{30,39}" }],
      [{ "regex": "[A-Z0-9<]{9}[0-9]JOR[0-9]{6}[0-9][MF<][0-9]{6}[0-9]" }],
      [{ "keywords": ["Passport"] }, { "keywords": ["JOR", "Jordan", "HASHEMITE KINGDOM"] }]
    ]
  },
  "Syrian Refugee Document": {
    "region": "Jordan",
    "rules": [
      [
        { "keywords": ["وزارة العمل", "تصريح عمل"] },
        { "keywords": ["المملكة الأردنية الهاشمية"] },
        { "keywords": ["سوري", "سورية", "السورية", "سوريا", "الجمهورية العربية السورية"] }
      ],
      [
        { "keywords": ["وثيقة خدمة"] },
        { "keywords": ["الجالية السورية"] }
      ],
      [
        { "keywords": ["المملكة الأردنية الهاشمية"] },
        { "keywords": ["مركز الدخول", "تاريخ الدخول"] },
        { "keywords": ["مديرية الشرطة"] }
      ],
      [
        { "regex": "\\b\\d{3}-\\d{8}\\b" },
        { "keywords": ["وثيقة خدمة", "الجالية السورية", "مركز الدخول", "تاريخ الدخول", "مديرية الشرطة"] }
      ],
      [
        { "keywords": ["UNHCR", "المفوضية السامية"] },
        { "keywords": ["طالب لجوء", "لاجئ", "Asylum Seeker", "Refugee"] }
      ]
    ]
  },
  "IBAN": {
    "region": "Jordan",
    "rules": [
      [{ "regex": "\\bJO[0-9]{2} ?[A-Z]{4}(?: ?[0-9]{4}){5} ?[0-9]{2}\\b" }]
    ]
  },
  "IP Address": {
    "region": null,
    "rules": [
      [{ "regex": "\\b(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\b" }]
    ]
  },
  "UNHCR Number": {
    "region": null,
    "rules": [
      [{ "regex": "\\b\\d{3}-\\d{2}C\\d{5}\\b" }],
      [{ "regex": "\\b\\d{3}-\\d{8}\\b" }]
    ]
  }
}
